# Which chain this process serves: bsc, ethereum or robinhood. Required.
SOLVER_CHAIN=bsc

# Must report the chain's id and support EIP-1898, state overrides and
# Multicall3.
SOLVER_RPC=https://bsc-rpc.publicnode.com

# bsc: the topology indexer that names each pair's pools. Every pool it names
# is proved against the factories and the Settler's CREATE2 before use.
SOLVER_INDEXER_URL=
# robinhood: the RPC its event-derived discovery reads logs from. Defaults to
# the chain's public RPC.
#SOLVER_LOGS_RPC=

# Transactions go through the chain's 0x Settler, found as the registry's
# ownerOf(2) and checked against the reviewed code hashes at startup.
SOLVER_FEE_BPS=0
SOLVER_POSITIVE_SLIPPAGE_MAX_BPS=0

# Keep service and RFQ credentials in the private runtime env.
SOLVER_SERVICE_TOKEN=
# Native needs a Settler build with executeWithNativeAuthorization; the
# reviewed upstream builds on bsc and robinhood have none, so enabling it there
# stops the solver. SOLVER_NATIVE_BENEFICIARY_SIGNING_KEY must be the key of
# the Settler's nativeAuthorizationSigner; startup checks the address.
SOLVER_NATIVE_RFQ_ENABLED=false
SOLVER_NATIVE_RFQ_API_KEY=
SOLVER_NATIVE_BENEFICIARY_SIGNING_KEY=
SOLVER_NATIVE_RFQ_URL=https://v2.api.native.org/swap-api-v2/
SOLVER_NATIVE_RFQ_TIMEOUT_MS=1500
SOLVER_NATIVE_RFQ_EXPIRY_SECONDS=60
# A Native quote with less time left is not offered. Keep it above the
# 30 s before its deadline at which the backend has a quote asked again.
SOLVER_NATIVE_RFQ_MIN_TTL_SECONDS=45
# All Native orderbook/firm HTTP admissions share this credential quota.
SOLVER_NATIVE_RFQ_QPS=4
SOLVER_NATIVE_RFQ_QUEUE_WAIT_MS=1000
SOLVER_NATIVE_RFQ_MAX_INFLIGHT=8
# Default: process mode. For replicas, uncomment the same HTTPS origin on ALL
# Native-serving instances, including the authority host. Do not set an empty URL.
#SOLVER_NATIVE_QUOTA_COORDINATOR_URL=https://native-quota.example.internal
# Enable on exactly one authority host; requires Native enabled + shared URL.
# Uses the same private SOLVER_SERVICE_TOKEN (at least 32 bytes) on all clients.
SOLVER_NATIVE_QUOTA_COORDINATOR_ENABLED=false
# Authority startup/restart waits this lifetime before granting work.
# 1000..=120000 ms and at least SOLVER_NATIVE_RFQ_QUEUE_WAIT_MS.
SOLVER_NATIVE_QUOTA_LEASE_MS=120000
# Optional operator-only RPC debt recovery (POST /rpc-recovery). Must differ
# from the service token. An RPC request whose outcome is unknown holds its
# dispatch slot for SOLVER_RPC_UNCERTAIN_RELEASE_SECS; release it sooner only
# after the provider confirms that ALL unknown requests have ended.
SOLVER_RPC_RECOVERY_TOKEN=

# Physical provider quota shared within one process, including cached read owners.
# Set the same opaque group name on endpoints using the same paid account.
SOLVER_RPC_QUOTA_GROUP=
SOLVER_RPC_MAX_DISPATCHES=32
SOLVER_RPC_DISPATCH_RPS=256
# How long an RPC request may wait for a dispatch slot before the quote gets 503.
#SOLVER_RPC_ADMISSION_WAIT_MS=2000
# How long a request whose outcome is unknown keeps its slot.
#SOLVER_RPC_UNCERTAIN_RELEASE_SECS=60

# profile_only routes through the chain's reviewed connectors; shadow and
# adjacency rank more of them with the topology indexer (bsc only).
SOLVER_DYNAMIC_CONNECTORS=profile_only

# Resident pool state (bsc, ethereum), off by default: every pool on the list,
# brought to each new block, quotes the pairs it covers from memory. The list
# is a JSON array of {"protocol","address","token0","token1","feePpm"}.
#SOLVER_RESIDENT=on
#SOLVER_RESIDENT_POLL_MS=1000
#SOLVER_RESIDENT_POOL_LIST_URL=https://pools.example.internal/bsc.json
# Pools that emitted no state-moving event since the last read keep their
# state; every pool is read whole at least this often (0: every block whole).
#SOLVER_RESIDENT_FULL_READ_MS=60000
# Connectors beyond the chain's own, routed where they have listed pools.
#SOLVER_RESIDENT_CONNECTORS=0x...,0x...

SOLVER_PORT=8899
# compact (default) or json: one log line per event on stdout.
SOLVER_LOG_FORMAT=compact
SOLVER_QUOTE_TIMEOUT=120
SOLVER_COMPUTE_CONCURRENCY=2
# Defaults to SOLVER_COMPUTE_CONCURRENCY * 4; valid range is compute..=256.
SOLVER_MAX_INFLIGHT_QUOTES=8
# With every slot busy a quote waits, in arrival order, up to this long (and
# never past its caller's x-quote-timeout-ms); two waiting per slot at most.
SOLVER_QUOTE_ADMISSION_WAIT_MS=1000

# Optional sampled-RSS rejection threshold; unset by default (no memory rejection).
# This example is 192MiB. Tune below the OS/container limit with workload evidence.
#SOLVER_RSS_ADMISSION_BYTES=201326592
# Estimated headroom per admitted request, not a hard memory/RSS bound (32MiB).
SOLVER_REQUEST_MEMORY_RESERVE_BYTES=33554432
